# ALLO BRISE DE GLACE — service systemd pour le backend FastAPI
# Emplacement : /etc/systemd/system/allobrisdeglace.service

[Unit]
Description=API Allo Brise de Glace
After=network.target mariadb.service exim4.service
Wants=mariadb.service

[Service]
Type=simple
WorkingDirectory=/var/www/allobrisdeglace.com/backend
ExecStart=/var/www/allobrisdeglace.com/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
