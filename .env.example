# ALLO BRISE DE GLACE — configuration exemple
# Ne jamais mettre de secrets dans Git.
# Copier vers backend/.env puis renseigner les valeurs.

NODE_ENV=production
APP_URL=https://allobrisdeglace.com
PORT=8001

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=allobrisdeglace
DB_USER=
DB_PASSWORD=

# Exim local
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM=
MAIL_TO=

# Google Ads / Analytics — laisser vide pour désactiver
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_ANALYTICS_ID=

SESSION_SECRET=
CORS_ORIGINS=https://allobrisdeglace.com,https://www.allobrisdeglace.com
