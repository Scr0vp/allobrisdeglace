# ALLO BRISE DE GLACE — exemple de configuration (ne jamais commiter de secrets)
# Copier ce fichier en backend/.env puis renseigner les valeurs.

NODE_ENV=production
APP_URL=https://allobrisdeglace.com
PORT=8001

# Base de données du preview Emergent (MongoDB) — voir README « Migration MariaDB »
MONGO_URL=mongodb://localhost:27017
DB_NAME=allobrisdeglace

# MariaDB (production — utilisé après migration de la couche données)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=allobrisdeglace
DB_USER=
DB_PASSWORD=

# SMTP local (Exim sur le serveur Ubuntu)
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Adresses d'expédition / réception des demandes de contact
MAIL_FROM=
MAIL_TO=

# Suivi Google (laisser vide pour désactiver — le site fonctionne sans)
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_ANALYTICS_ID=

SESSION_SECRET=
